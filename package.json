{
  "name": "shared-nothing",
  "version": "1.0.0",
  "description": "Serialization-free, lock-free shared-memory object graph for Node.js worker threads, written in Rust (N-API). Powered by Vexify · Apache-2.0.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "keywords": [
    "shared-memory",
    "worker-threads",
    "napi",
    "rust",
    "lock-free",
    "SharedArrayBuffer",
    "concurrency"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "napi build --platform --release --zig",
    "build:native": "cargo build --release",
    "artifacts": "napi artifacts",
    "prepare": "napi build --platform --release --zig || true",
    "test": "node --test tests/integration.mjs tests/worker-stress.mjs",
    "bench": "node benches/bench.mjs"
  },
  "napi": {
    "name": "shared-nothing",
    "binaryName": "shared-nothing",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "i686-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}